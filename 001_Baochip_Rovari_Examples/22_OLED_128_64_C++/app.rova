 *
 * Program:  21_OLED (C++ style)
 * Platform: Baochip-1x / Rovari SDK
 * Hardware: SSD1306 128x64 OLED on I2C
 *           SCL=PB11, SDA=PB12 (4.7K pullups)
 */

#include "rovari.h"
#include "rovari_ssd1306.h"

Oled oled(I2C_1, OLED_128x64);

void app_init(void)
{
    i2c_init(I2C_1, 400000);
    oled.begin();
    oled.clear();

    oled.printLine(0, "Baochip-1x");
    oled.printLine(1, "Rovari SDK");

    oled.circle(96, 32, 15);
    oled.rect(80, 48, 32, 12);

    oled.display();
}

void app_run(void)
{
    static uint32_t count = 0;
    oled.printLine(5, "Count: %u", count++);
    oled.display();
    delay(500);
}