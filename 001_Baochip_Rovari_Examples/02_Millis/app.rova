 * Program:  02_Millis (C style)
 * Platform: Baochip-1x / Rovari SDK
 * Hardware: LED on PB1 via 1K resistor
 */

#include "rovari.h"

uint64_t last_toggle = 0;

void app_init(void)
{
    pin_mode(PB1, Output);
}

void app_run(void)
{
    if (millis() - last_toggle >= 500)
    {
        last_toggle = millis();
        pin_toggle(PB1);
    }
}