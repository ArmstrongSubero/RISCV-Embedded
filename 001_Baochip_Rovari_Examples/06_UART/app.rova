 * Program:  06_UART (C style)
 * Platform: Baochip-1x / Rovari SDK
 * Hardware: UART2 on PB14(TX), PB13(RX)
 */

#include "rovari.h"

void app_init(void)
{
    mini_printf("Baochip-1x UART Ready\r\n");
}

void app_run(void)
{
    if (uart_is_readable(2))
    {
        char c = uart_getc(2);

        if (c != '\r' && c != '\n')
        {
            mini_printf("Got: %c\r\n", c);
        }
    }
}