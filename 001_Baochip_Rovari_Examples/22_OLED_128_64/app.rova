/*
 * Copyright (c) 2026 Armstrong Subero
 *
 * Program:  21_OLED (C style)
 * Platform: Baochip-1x / Rovari SDK
 * Hardware: SSD1306 128x64 OLED on I2C
 *           SCL=PB11, SDA=PB12 (4.7K pullups)
 */

#include "rovari.h"
#include "rovari_ssd1306.h"

void app_init(void)
{
    i2c_init(I2C_1, 400000);
    oled_init(I2C_1, OLED_128x64, SSD1306_I2C_ADDR);
    oled_clear();

    oled_printf_line(0, "Baochip-1x");
    oled_printf_line(1, "Rovari SDK");

    oled_circle(96, 32, 15, OLED_COLOR_WHITE);
    oled_rect(80, 48, 32, 12, OLED_COLOR_WHITE);

    oled_display();
}

void app_run(void)
{
    static uint32_t count = 0;
    oled_printf_line(5, "Count: %u", count++);
    oled_display();
    delay(500);
}