 * Program:  07_ADC (C style)
 * Platform: Baochip-1x / Rovari SDK
 * Hardware: potentiometer on 3.3V/GND, wiper through
 *           2.2K/1K divider to PC9 (ADC ch0)
 */

#include "rovari.h"

void app_init(void)
{
    adc_init(PC9);
    mini_printf("ADC Reading\r\n");
}

void app_run(void)
{
    uint16_t raw = analog_read(PC9);
    uint16_t mv  = adc_raw_to_mv(raw);

    mini_printf("raw: %d  mv: %d\r\n", raw, mv);
    delay(500);
}