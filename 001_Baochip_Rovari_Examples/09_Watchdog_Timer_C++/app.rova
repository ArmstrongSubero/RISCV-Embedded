/*
 * Copyright (c) 2026 Armstrong Subero
 *
 * Program:  09_Watchdog (C++ style)
 * Platform: Baochip-1x / Rovari SDK
 * Hardware: LED on PB1 via 330R resistor
 *
 * LED blinks normally while the watchdog is fed.
 * Comment out the wdt_feed() call and the board
 * resets every 2 seconds.
 */

#include "rovari.h"
#include "hardware/wdt.h"

Gpio led(PB1, Output);

void app_init(void)
{
    wdt_start(2000);
    mini_printf("Watchdog started (2s timeout)\r\n");
}

void app_run(void)
{
    led.toggle();
    delay(500);
    //wdt_feed();
}