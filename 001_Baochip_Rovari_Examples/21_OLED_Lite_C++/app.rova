 * Program:  22_OLED_Lite (C++ style)
 * Platform: Baochip-1x / Rovari SDK
 * Hardware: SSD1306 128x32 OLED on I2C
 *           SCL=PB11, SDA=PB12 (4.7K pullups)
 */

#include "rovari.h"
#include "rovari_ssd1306.h"

Oled oled(I2C_1, OLED_128x32);

void app_init(void)
{
    i2c_init(I2C_1, 400000);
    oled.begin();
    oled.clear();
    
    oled.setOrientation(OLED_ORIENT_180);

    oled.printLine(0, "Baochip-1x");
    oled.printLine(1, "Rovari SDK");
}

void app_run(void)
{
    static uint32_t count = 0;
    oled.printLine(3, "Count: %u", count++);
    delay(500);
}