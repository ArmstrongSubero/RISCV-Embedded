 * Program:  01_Pushbutton (C++ style)
 * Platform: Baochip-1x / Rovari SDK
 * Hardware: LED on PB1 via 330R resistor
 *           pushbutton on PB2 to GND
 */

#include "rovari.h"

Gpio led(PB1, Output);
Button btn(PB2);

void app_init(void)
{
}

void app_run(void)
{
    if (btn.pressed())
    {
        led.toggle();
    }
}