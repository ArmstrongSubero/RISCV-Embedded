 * Platform: Baochip-1x / Rovari SDK
 * Hardware: LED on PB1 via 1K resistor
 */

#include "rovari.h"
#include "hardware/timer.h"
#include "hardware/irq.h"

void timer0_handler(uint32_t pending)
{
    (void)pending;
    pin_toggle(PB1);
    TIMER0_EV_PENDING = 1;
}

void app_init(void)
{
    pin_mode(PB1, Output);

    irq_init();
    irq_set_handler(IRQ_TIMER0, timer0_handler);
    irq_enable(IRQ_TIMER0);
    timer0_start_periodic_ms(100);
}

void app_run(void)
{
}