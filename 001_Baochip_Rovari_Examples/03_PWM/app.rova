 * Program:  03_PWM (C style)
 * Platform: Baochip-1x / Rovari SDK
 * Hardware: LED on PB1 (PWM slice 1, ch 1) via 1K resistor
 */

#include "rovari.h"

void app_init(void)
{
    pwm_init(PB1, 1000);
}

void app_run(void)
{
    for (uint8_t i = 0; i < 254; i++)
    {
        pwm_write(PB1, i);
        delay(10);
    }

    for (int i = 254; i >= 0; i--)
    {
        pwm_write(PB1, (uint8_t)i);
        delay(10);
    }
}