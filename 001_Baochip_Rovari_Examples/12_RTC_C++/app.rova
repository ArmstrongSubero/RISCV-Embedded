#include "rovari.h"
#include "hardware/rtc.h"

void app_init(void)
{
    rtc_init();
    rtc_set_time(0);
    rtc_start();
    mini_printf("RTC started\r\n");
}

void app_run(void)
{
    uint32_t t = rtc_get_time();
    uint32_t hours = t / 3600;
    uint32_t mins  = (t % 3600) / 60;
    uint32_t secs  = t % 60;

    mini_printf("Uptime: %02d:%02d:%02d (%d s)\r\n",
                hours, mins, secs, t);

    delay(1000);
}